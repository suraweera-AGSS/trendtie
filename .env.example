# Copy to .env.local and fill in. Never commit real credentials.

# ---- Site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- MongoDB Atlas (step 2) -------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trendtie?retryWrites=true&w=majority

# ---- NextAuth / Auth.js (step 4) --------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- Stripe, test mode (step 5) ---------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Cloudinary (step 7) ----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
